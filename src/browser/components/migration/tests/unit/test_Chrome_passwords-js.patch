+// Signed-in Chrome profiles keep their passwords in "Login Data For Account"
+// next to "Login Data"; both databases must be imported, and a login present in
+// both must be imported only once.
+add_task(async function test_importFromAccountStore() {
+  const accountDataFilePath = PathUtils.join(
+    PathUtils.parent(loginDataFilePath),
+    "Login Data For Account"
+  );
+  registerCleanupFunction(() => IOUtils.remove(accountDataFilePath));
+
+  const migrator = await MigrationUtils.getMigrator("chrome");
+  const migrateFresh = async () => {
+    await Services.logins.removeAllUserFacingLoginsAsync();
+    // The migrator caches resources per profile; drop them so the new
+    // database is picked up.
+    delete migrator._resourcesByProfile[PROFILE.id];
+    await promiseMigration(
+      migrator,
+      MigrationUtils.resourceTypes.PASSWORDS,
+      PROFILE,
+      true
+    );
+    return Services.logins.getAllLogins();
+  };
+
+  // The account database holds logins for other origins than the local one.
+  const toAccountOrigin = origin => origin.replace("://", "://account.");
+  await dbConn.execute("VACUUM INTO :path", { path: accountDataFilePath });
+  const accountConn = await Sqlite.openConnection({
+    path: accountDataFilePath,
+  });
+  await accountConn.execute(
+    `UPDATE logins SET
+       origin_url = replace(origin_url, '://', '://account.'),
+       action_url = replace(action_url, '://', '://account.'),
+       signon_realm = replace(signon_realm, '://', '://account.')`
+  );
+  await accountConn.close();
+
+  let logins = await migrateFresh();
+  Assert.equal(
+    logins.length,
+    2 * TEST_LOGINS.length,
+    "Logins are imported from both databases"
+  );
+  for (const local of TEST_LOGINS) {
+    const expected = {
+      ...local,
+      origin: toAccountOrigin(local.origin),
+      formActionOrigin:
+        local.formActionOrigin && toAccountOrigin(local.formActionOrigin),
+    };
+    const actual = findMatchingLogin(logins, expected);
+    Assert.ok(actual, "Found account login for ID " + local.id);
+    checkLoginsAreEqual(actual, expected, local.id);
+  }
+
+  // Both databases hold the same logins.
+  await IOUtils.remove(accountDataFilePath);
+  await dbConn.execute("VACUUM INTO :path", { path: accountDataFilePath });
+  logins = await migrateFresh();
+  Assert.equal(
+    logins.length,
+    TEST_LOGINS.length,
+    "Logins present in both databases are imported once"
+  );
+  Assert.equal(
+    MigrationUtils._importQuantities.logins,
+    TEST_LOGINS.length,
+    "Telemetry counts each login once"
+  );
+});
