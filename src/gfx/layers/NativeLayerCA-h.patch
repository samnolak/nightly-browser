+// Told about the surface a NativeLayerRootCA presents after each
+// CommitToScreen(). zen/embed uses it to export the frames of windows that an
+// external process embeds. Called on the committing thread with the root's
+// lock held; must not call back into the root.
+class NativeLayerRootCAObserver {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(NativeLayerRootCAObserver)
+  virtual void OnCommitToScreen(IOSurfaceRef aSurface, const gfx::IntSize& aSize,
+                                bool aIsFlipped) = 0;
+
+ protected:
+  virtual ~NativeLayerRootCAObserver() = default;
+};
