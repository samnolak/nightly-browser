+void NativeLayerRootCA::SetObserver(NativeLayerRootCAObserver* aObserver) {
+  MutexAutoLock lock(mMutex);
+  mObserver = aObserver;
+}
+
 UniquePtr<NativeLayerRootSnapshotter> NativeLayerRootCA::CreateSnapshotter() {
 #ifdef XP_MACOSX
   MutexAutoLock lock(mMutex);
@@ -1527,6 +1545,24 @@ CGColorRef CGColorCreateForDeviceColor(const gfx::DeviceColor& aColor) {
   return updateSucceeded;
 }
 
+CFTypeRefPtr<IOSurfaceRef> NativeLayerCA::CurrentSurface(gfx::IntSize* aSize,
+                                                         bool* aIsFlipped) {
+  MutexAutoLock lock(mMutex);
+  *aSize = mSize;
+  *aIsFlipped = mSurfaceIsFlipped;
+  if (mSurfaceToPresent) {
+    return mSurfaceToPresent;
+  }
+  if (mSurfaceHandler) {
+    *aSize = mSurfaceHandler->Size();
+    *aIsFlipped = mSurfaceHandler->SurfaceIsFlipped();
+    if (auto frontSurface = mSurfaceHandler->FrontSurface()) {
+      return frontSurface->mSurface;
+    }
+  }
+  return nullptr;
+}
+
 CALayer* NativeLayerCA::UnderlyingCALayer(WhichRepresentation aRepresentation) {
