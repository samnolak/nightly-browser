+
 void nsCocoaWindow::DispatchOcclusionEvent() {
   if (!mWindow) {
     return;
   }
 
+  if (mIsEmbedded) {
+    // AppKit reports an ordered-out window as occluded; the embedder owns
+    // visibility. Occluded only while it hides the pane: the docshells go
+    // inactive and the compositor pauses
+    // (CanonicalBrowsingContext::RecomputeAppWindowVisibility), and both
+    // resume when it shows the pane again.
+    if (mIsFullyOccluded != mEmbedderHidden) {
+      mIsFullyOccluded = mEmbedderHidden;
+      if (mWidgetListener) {
+        mWidgetListener->OcclusionStateChanged(mIsFullyOccluded);
+      }
+    }
+    return;
+  }
+
   // macOS occasionally reports a window as not visible (its occlusionState is
