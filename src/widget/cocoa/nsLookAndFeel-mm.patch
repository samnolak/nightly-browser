+// The corner radius macOS gives a browser window (titled, full-size content,
+// no toolbar): 16 on macOS 26, or what the user's NSConvolutionOverride1 sets.
+// A window that is never shown is enough to read it.
+static int32_t BrowserWindowCornerRadius() {
+  SEL selector = NSSelectorFromString(@"_cornerRadius");
+  if (NSApp) {
+    NSWindow* window = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(0, 0, 100, 100)
+                  styleMask:NSWindowStyleMaskTitled |
+                            NSWindowStyleMaskClosable |
+                            NSWindowStyleMaskMiniaturizable |
+                            NSWindowStyleMaskResizable |
+                            NSWindowStyleMaskFullSizeContentView
+                    backing:NSBackingStoreBuffered
+                      defer:YES];
+    window.releasedWhenClosed = NO;
+    CGFloat radius = -1;
+    if ([window respondsToSelector:selector]) {
+      radius = ((CGFloat(*)(id, SEL))objc_msgSend)(window, selector);
+    }
+    [window release];
+    if (radius >= 0) {
+      return NSToIntRound(radius);
+    }
+  }
+  return nsCocoaFeatures::OnTahoeOrLater() ? 16 : 10;
+}
