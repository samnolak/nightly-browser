+// Native sheets cannot attach to another process's NSWindow. Send the print
+// info to the authenticated embedder, which presents its own NSPrintPanel on
+// the visible window and returns the updated info. Standalone windows retain
+// the ordinary panel (including their Gecko accessory controller).
+class EmbedPrintReply final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+  explicit EmbedPrintReply(void (^aDone)(NSPrintInfo*)) : mDone([aDone copy]) {}
+  NS_IMETHOD Observe(nsISupports*, const char*, const char16_t* aData) override {
+    NSPrintInfo* info = nil;
+    if (aData && *aData) {
+      NSString* text = [NSString stringWithUTF8String:
+          NS_ConvertUTF16toUTF8(aData).get()];
+      NSData* archive = [[[NSData alloc] initWithBase64EncodedString:text
+                                                            options:0] autorelease];
+      @try {
+        id result = [NSKeyedUnarchiver unarchivedObjectOfClass:[NSPrintInfo class]
+                                                   fromData:archive error:nil];
+        if ([result isKindOfClass:[NSPrintInfo class]]) info = result;
+      } @catch (NSException*) {
+        // A malformed peer response cancels, never falls back to a hidden sheet.
+      }
+    }
+    if (mDone) {
+      auto done = mDone;
+      mDone = nil;
+      done(info);
+      [done release];
+    }
+    return NS_OK;
+  }
+ private:
+  ~EmbedPrintReply() { [mDone release]; }
+  void (^mDone)(NSPrintInfo*);
+};
+NS_IMPL_ISUPPORTS(EmbedPrintReply, nsIObserver)
+
+static bool ShowEmbeddedPrintPanel(mozIDOMWindowProxy* aParent,
+                                  NSPrintInfo* aInfo, bool aPageSetup,
+                                  void (^aDone)(NSPrintInfo*)) {
+  auto* outer = nsPIDOMWindowOuter::From(aParent);
+  nsCOMPtr<nsIWidget> widget = WidgetUtils::DOMWindowToWidget(outer);
+  if (!widget || !static_cast<nsCocoaWindow*>(widget.get())->IsEmbedded()) {
+    return false;
+  }
+  NSData* archive = [NSKeyedArchiver archivedDataWithRootObject:aInfo
+                                      requiringSecureCoding:YES error:nil];
+  NSDictionary* question = @{
+    @"kind": @"print", @"pageSetup": @(aPageSetup),
+    @"windowId": @(outer->WindowID()),
+    @"printInfo": [archive base64EncodedStringWithOptions:0] ?: @""
+  };
+  NSData* json = [NSJSONSerialization dataWithJSONObject:question options:0 error:nil];
+  nsAutoCString data;
+  data.Assign(static_cast<const char*>([json bytes]), [json length]);
+  RefPtr<EmbedPrintReply> reply = new EmbedPrintReply(aDone);
+  nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+  if (observers && archive && json) {
+    observers->NotifyObservers(reply, "zen-embed-print-panel",
+                               NS_ConvertUTF8toUTF16(data).get());
+  } else {
+    reply->Observe(nullptr, nullptr, u"");
+  }
+  return true;
+}
