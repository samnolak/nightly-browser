if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    EXPORTS.mozilla += [
        "ZenEmbedHost.h",
    ]

    SOURCES += [
        "ZenEmbedHost.mm",
    ]

    # nsChildView.h (the drag destination of an embedded window's view)
    # pulls in TextInputHandler.h and with it these layout headers.
    LOCAL_INCLUDES += [
        "/layout/base",
        "/layout/generic",
        "/layout/xul",
        "/widget",
        "/widget/cocoa",
    ]

    # NativeLayerCA.h pulls in IPDL-generated layer headers.
    include("/ipc/chromium/chromium-config.mozbuild")

    FINAL_LIBRARY = "xul"

    FINAL_TARGET_FILES.actors += [
        "ZenEmbedAgentChild.sys.mjs",
        "ZenEmbedAugur.sys.mjs",
        "ZenEmbedBrowser.sys.mjs",
        "ZenEmbedDialogs.sys.mjs",
    ]
